# ─── App ───────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────────────────
# Used inside Docker (service name "db")
DATABASE_URL=postgresql://careerpilot:careerpilot@db:5432/careerpilot

# PostgreSQL credentials (used by docker-compose to init the db service)
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot
POSTGRES_DB=careerpilot

# ─── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI Provider (Google Gemini) ───────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# Primary 完整失敗（retry / repair 皆盡）時的備援模型（留空 = 停用 fallback）
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ─── Observability (LangSmith, optional) ───────────────────────────
# 未設定時 tracing 靜默停用，不影響任何功能
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=careerpilot-ai

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ─── Upload / Input limits ─────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
# 貼上文字（resume / job）長度上限
MAX_TEXT_INPUT_CHARS=50000

# ─── Rate limiting（Phase 9；in-memory，per-process）────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_JOB_CREATE=20/minute
RATE_LIMIT_MATCH=5/minute
RATE_LIMIT_SKILL_GAP=5/minute
RATE_LIMIT_KIT=3/minute

# ─── Evaluation (Phase 8, optional — defaults shown) ───────────────
# eval 專用獨立資料庫（不與開發 DB 共用；host 端連線所以是 localhost）
# EVAL_DATABASE_URL=postgresql://careerpilot:careerpilot@localhost:5432/careerpilot_eval
# LLM-as-judge 模型（ER-6；額度不足時可換）
# EVAL_JUDGE_MODEL=gemini-3.6-flash
# Client-side 節流秒數（free tier 防 429→fallback 誤觸發；付費帳號可設 0）
# EVAL_GEN_MIN_INTERVAL=6.5
# EVAL_JUDGE_MIN_INTERVAL=10
# embedding 節流是 per-text（free tier 配額按批內每段文字計，100/min）
# EVAL_EMBED_MIN_INTERVAL=0.7
