# ─── App ───────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────────────────
# Used inside Docker (service name "db")
DATABASE_URL=postgresql://careerpilot:careerpilot@db:5432/careerpilot

# PostgreSQL credentials (used by docker-compose to init the db service)
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot
POSTGRES_DB=careerpilot

# ─── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI Provider (Google Gemini) ───────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=text-embedding-004

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ─── Upload ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
